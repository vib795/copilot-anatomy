    // ── Python ───────────────────────────────────────────────────────────
    "ms-python.python",
    "ms-python.black-formatter",
    "charliermarsh.ruff",

    // ── Infrastructure ────────────────────────────────────────────────────
    "hashicorp.terraform",
    "ms-kubernetes-tools.vscode-kubernetes-tools",
    "tim-koehler.helm-intellisense",
    "ms-azuretools.vscode-docker",

    // ── Data formats ──────────────────────────────────────────────────────
