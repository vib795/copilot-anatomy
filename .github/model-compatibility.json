{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Model compatibility matrix for Copilot asset routing. Defines available models, their capabilities, and fallback behavior.",
  "version": "1.0.0",
  "models": [
    {
      "name": "o3",
      "vendor": "openai",
      "slot": "reason",
      "capabilities": ["reasoning", "planning", "architecture"],
      "costTier": "high",
      "contextWindow": "200k",
      "bestFor": "Architecture decisions, complex reasoning, planning"
    },
    {
      "name": "o4-mini",
      "vendor": "openai",
      "slot": "fast",
      "capabilities": ["completions", "quick-fixes", "boilerplate"],
      "costTier": "low",
      "contextWindow": "200k",
      "bestFor": "Inline completions, quick fixes, boilerplate"
    },
    {
      "name": "gpt-4.1",
      "vendor": "openai",
      "slot": "balanced",
      "capabilities": ["general", "devops", "balanced"],
      "costTier": "medium",
      "contextWindow": "1M",
      "bestFor": "General-purpose, DevOps commands, balanced tasks"
    },
    {
      "name": "claude-sonnet-4-5",
      "vendor": "anthropic",
      "slot": "code",
      "capabilities": ["code-generation", "review", "documentation", "testing"],
      "costTier": "medium",
      "contextWindow": "200k",
      "bestFor": "Code generation, review, documentation, tests"
    },
    {
      "name": "claude-opus-4-5",
      "vendor": "anthropic",
      "slot": "thorough",
      "capabilities": ["security-audit", "deep-review", "nuanced-analysis"],
      "costTier": "high",
      "contextWindow": "200k",
      "bestFor": "Security audits, thorough review, nuanced analysis"
    },
    {
      "name": "claude-haiku-4-5",
      "vendor": "anthropic",
      "slot": null,
      "capabilities": ["fast-iteration", "light-review"],
      "costTier": "low",
      "contextWindow": "200k",
      "bestFor": "Fast chatmodes needing quick iteration"
    },
    {
      "name": "gemini-2.5-pro",
      "vendor": "google",
      "slot": "longctx",
      "capabilities": ["long-context", "codebase-reading"],
      "costTier": "high",
      "contextWindow": "1M",
      "bestFor": "Reading large codebases, entire repos"
    },
    {
      "name": "gemini-2.0-flash",
      "vendor": "google",
      "slot": null,
      "capabilities": ["fast-long-context", "multi-file-analysis"],
      "costTier": "medium",
      "contextWindow": "1M",
      "bestFor": "Quick analysis of many files simultaneously"
    }
  ],
  "fallbackPolicy": {
    "description": "Defines behavior when a configured model is unavailable",
    "gated": {
      "behavior": "fail-closed",
      "description": "Workflows with release-gating decisions (eval checks, security scans) must fail if the specified model is unavailable. No silent fallback.",
      "appliesTo": ["security-scan.prompt.md", "copilot-eval.yml", "copilot-hooks.yml"],
      "errorMessage": "Gated workflow requires model '{model}' which is currently unavailable. Workflow blocked — no fallback permitted."
    },
    "advisory": {
      "behavior": "controlled-fallback",
      "description": "Advisory workflows (code review, documentation, general chat) may fall back to an alternative model with explicit reporting.",
      "fallbackOrder": [
        { "from": "o3", "to": ["gpt-4.1"] },
        { "from": "o4-mini", "to": ["gemini-2.0-flash", "gpt-4.1"] },
        { "from": "claude-sonnet-4-5", "to": ["gpt-4.1"] },
        { "from": "claude-opus-4-5", "to": ["claude-sonnet-4-5", "gpt-4.1"] },
        { "from": "gemini-2.5-pro", "to": ["gpt-4.1"] },
        { "from": "gemini-2.0-flash", "to": ["o4-mini", "gpt-4.1"] },
        { "from": "gpt-4.1", "to": ["claude-sonnet-4-5"] }
      ],
      "reportingRequirement": "When a fallback occurs, the output must include a notice: 'Note: This response was generated by {fallback_model} because {requested_model} was unavailable.'"
    }
  },
  "slots": {
    "description": "Named model slots defined in .vscode/settings.json. Maps slot labels to model names for frontmatter references.",
    "fast": "o4-mini",
    "reason": "o3",
    "code": "claude-sonnet-4-5",
    "thorough": "claude-opus-4-5",
    "longctx": "gemini-2.5-pro",
    "balanced": "gpt-4.1"
  }
}
